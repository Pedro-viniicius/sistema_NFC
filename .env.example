# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit de .env.local.

# Conexão PostgreSQL.
# Local (docker compose up -d):
DATABASE_URL=postgres://nfc:nfc@localhost:54329/nfc
# Produção (Neon): use a URL "pooled" (host com -pooler) e sslmode=require, por exemplo:
# DATABASE_URL=postgres://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo usado para assinar a sessão do painel (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Domínio canônico dos cartões. É ESTA URL que vai impressa no QR Code e gravada no NFC.
# Em produção use o domínio definitivo (https). Nunca use localhost nem URL de preview aqui.
NEXT_PUBLIC_APP_URL=https://go.meudominio.com

# Armazenamento dos PDFs de template de impressão (Vercel Blob, acesso privado).
# Na Vercel, a variável é criada ao conectar um Blob store ao projeto:
#   vercel blob create-store sistema-nfc-templates --access private --region gru1
# Em desenvolvimento (`pnpm dev`) ela é opcional: sem ela, os PDFs ficam em .armazenamento-local/.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Só para testar o build de produção na própria máquina (`pnpm build && pnpm start`) sem o Blob:
# grava os PDFs em .armazenamento-local/. É ignorada (e recusada) na Vercel.
# ARMAZENAMENTO_LOCAL=1
